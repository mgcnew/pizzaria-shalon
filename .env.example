# ---------------------------------------------------------------------------
# Pizzaria Shalon — exemplo de variáveis de ambiente
#
# Copie para .env.local e preencha com os valores do SEU ambiente.
# .env* está no .gitignore: NUNCA versione valores reais (CLAUDE.md §45).
#
# Nenhum projeto Supabase foi conectado na Fase 1. Estas variáveis existem
# como contrato de configuração e passam a ser preenchidas na Fase 2.
# ---------------------------------------------------------------------------

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima/publishable do Supabase (pública, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Fase 5 — criação segura do pedido
# ---------------------------------------------------------------------------

# Segredo de origem servidor -> banco (CLAUDE.md §16).
#
# NÃO é `service_role` e não concede acesso a nada: apenas prova que a chamada
# de `criar_pedido` partiu do nosso servidor, e não do navegador. Sem ele, o
# checkout não cria pedido algum.
#
# O valor é gerado aleatoriamente pela migration 0040, DENTRO de cada projeto.
# Cada ambiente tem o seu: o de produção é diferente do de desenvolvimento, e
# copiar um para o outro seria erro. Nunca esteve no Git.
#
# ONDE OBTER — depende de já existir um Owner no ambiente:
#
#   1. AMBIENTE NOVO, ainda sem o primeiro Owner (bootstrap). A via abaixo
#      NÃO funciona ainda, porque `ler_segredo_do_servidor` exige
#      `settings.manage` e não há usuário interno para tê-la. Leia
#      administrativamente, no SQL Editor, que roda como dono do banco:
#
#          select valor from public.server_secrets where chave = 'checkout_origem';
#
#      Isso funciona porque `server_secrets` tem RLS ligada e SEM `force`, de
#      propósito (migration 0040): as funções SECURITY DEFINER precisam ler.
#
#   2. AMBIENTE JÁ COM OWNER — esta é a via normal, e a preferida:
#
#          select public.ler_segredo_do_servidor('checkout_origem');
#
#      Exige estar autenticado com `settings.manage`.
#
# Em qualquer dos dois: copie direto para o gerenciador de senhas e para a
# variável de ambiente. Não passe por arquivo versionado, chat ou ticket.
SHALON_CHECKOUT_ORIGIN_SECRET=

# ---------------------------------------------------------------------------
# HERE Location Services — distância real de rota viária (CLAUDE.md §20)
# ---------------------------------------------------------------------------

# Chave SERVER-SIDE, usada por Geocoding & Search v1 e Routing v8.
#
# É O PROVEDOR DE PRODUÇÃO desde D-2026-09-24-75. Sem ela a entrega fica
# indisponível — o sistema NÃO estima distância e NÃO cobra R$ 0,00 por falta
# de cálculo. A retirada continua funcionando normalmente.
#
# NUNCA `NEXT_PUBLIC_`: o HERE autentica por parâmetro de consulta, então a
# chave viaja na URL. Exposta ao navegador, ela seria lida e usada por
# terceiros contra a sua franquia. O provedor também nunca registra a URL em
# log, só o status HTTP — não mude isso "para depurar".
#
# Restrição por IP não se aplica na Vercel, que não tem egresso estático.
# Ressalva registrada em docs/06-PENDENCIAS-VALIDACAO-PRODUCAO.md.
HERE_API_KEY=

# Reserva de mapas (D-2026-10-16-142): TomTom, usada só quando o HERE não
# localiza o endereço. Opcional; sem ela, só o HERE. Só no servidor.
TOMTOM_API_KEY=

# ---------------------------------------------------------------------------
# Google Maps Platform — LEGADO, fora do fluxo ativo
# ---------------------------------------------------------------------------

# Mantida apenas durante a transição (D-2026-09-24-75). O seletor de provedor
# NÃO lê mais esta variável, e `google.ts` não participa da seleção: o
# faturamento do Google não foi ativado, então um fallback automático para lá
# só produziria erro de credencial disfarçado de rede de proteção.
#
# Pode ficar vazia. Preenchê-la não reativa nada.
GOOGLE_MAPS_SERVER_KEY=

# ---------------------------------------------------------------------------
# PROIBIDO neste arquivo e em qualquer variável NEXT_PUBLIC_*:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - chaves privadas de API (Google Routes/Geocoding etc.)
#   - qualquer segredo de servidor
# Ver CLAUDE.md §13 e §45.
# ---------------------------------------------------------------------------
