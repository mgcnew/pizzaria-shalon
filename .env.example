# ---------------------------------------------------------------------------
# Pizzaria Shalon — exemplo de variáveis de ambiente
#
# Copie para .env.local e preencha com os valores do SEU ambiente.
# .env* está no .gitignore: NUNCA versione valores reais (CLAUDE.md §45).
#
# Nenhum projeto Supabase foi conectado na Fase 1. Estas variáveis existem
# como contrato de configuração e passam a ser preenchidas na Fase 2.
# ---------------------------------------------------------------------------

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima/publishable do Supabase (pública, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# PROIBIDO neste arquivo e em qualquer variável NEXT_PUBLIC_*:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - chaves privadas de API (Google Routes/Geocoding etc.)
#   - qualquer segredo de servidor
# Ver CLAUDE.md §13 e §45.
# ---------------------------------------------------------------------------
