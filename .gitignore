# ---------------------------------------------------------------------------
# Pizzaria Shalon — .gitignore
#
# A stack ainda NÃO foi definida (ver CLAUDE.md §44-A). As regras abaixo são
# genéricas para projetos Node/web e não presumem framework, gestor de pacotes
# nem estratégia de estilização. Devem ser revistas quando a stack for decidida.
# ---------------------------------------------------------------------------

# Dependências
node_modules/
.pnp
.pnp.*
jspm_packages/

# Build / saída
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.vercel/
*.tsbuildinfo

# Segredos e ambiente — NUNCA versionar (CLAUDE.md §45)
.env
.env.*
!.env.example

# Supabase — artefatos locais
.branches/
.temp/
supabase/.temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura e testes
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Cache de ferramentas
.cache/
.eslintcache
.stylelintcache
.parcel-cache/

# Sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editores
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Design — estado local do protótipo (não é fonte)
# Os arquivos .dc.html, support.js, image-slot.js e uploads/ SÃO versionados:
# constituem a referência visual oficial do projeto (CLAUDE.md §7).
**/.image-slots.state.json

# Ferramentas locais de desenvolvimento
.claude/

# Fontes raster originais dos assets públicos. As versões WebP otimizadas
# ficam em public/categorias e public/marca e são as únicas enviadas ao deploy.
/public/bebidas.png
/public/combos.png
/public/fogazza.png
/public/logo.png
/public/marca/logo.png
/public/pizza doce.png
/public/pizza salgada.png
/public/tudo.png
